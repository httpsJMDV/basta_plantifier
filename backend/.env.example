APP_NAME=PlantifierAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8024
# php artisan serve uses this port, so Google sign-in and links match APP_URL.
SERVER_PORT=8024

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plantifierai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# AI providers. Keys can also be added later in Admin > AI providers.
AI_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_COMPLETION_TOKENS=768
PLANTNET_API_KEY=
PLANTNET_PROJECT=all
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FALLBACK_ENABLED=true

# Google sign-in (optional). Register this exact redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8024/auth/google/callback

# Live chat updates (php artisan reverb:start). Any local values work.
REVERB_APP_ID=plantifier
REVERB_APP_KEY=plantifier-local-key
REVERB_APP_SECRET=plantifier-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8084
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8084

# Admin authenticator + password re-entry. Off when APP_ENV=local; set true to require it.
# ADMIN_MFA=true
# Where admin backups are saved (defaults to the project's backups folder).
# BACKUP_PATH=
